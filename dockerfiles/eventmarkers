FROM xilinx/kria-developer:2022.1 as build

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace


RUN \
    apt update ; \
    apt install --yes libusb-1.0-0-dev ; \
    apt install --yes libopencv-dev libboost-all-dev libboost-program-options-dev libusb-1.0-0-dev libprotobuf-dev protobuf-compiler ; \
    apt update --fix-missing;
RUN apt install --yes libhdf5-dev
RUN apt install --yes hdf5-tools
RUN apt install --yes libglew-dev
RUN apt install --yes libglfw3-dev
RUN apt install --yes libcanberra-gtk-module
RUN apt install --yes ffmpeg

RUN apt update --fix-missing ;\
    apt install --yes libhdf5-dev ;\
    apt install --yes libceres-dev ;\
    apt install --yes nlohmann-json3-dev ;\
    apt install --yes apt-utils wget software-properties-common gpg ca-certificates unzip cmake libeigen3-dev libogre-1.12-dev libimgui-dev libfreetype-dev libprotobuf-dev protobuf-compiler xterm gcc-multilib net-tools gawk libncurses-dev zlib1g:i386 libtinfo5 python3.$PYTHON3_VERSION-venv ; \
    apt install --yes git python3 python3-pip python3-setuptools python3-wheel ninja-build ;\
    pip3 install meson ;

RUN mkdir -p /workspace/sophus
ADD https://github.com/strasdat/Sophus/archive/refs/tags/1.22.10.zip /workspace/sophus/

RUN \
    unzip /workspace/sophus/1.22.10.zip -d /workspace/sophus ;\
    cmake -S /workspace/sophus/Sophus-1.22.10 -B /workspace/sophus/Sophus-1.22.10 ; \
    cmake --build /workspace/sophus/Sophus-1.22.10 --target install -j1 ;

FROM xilinx/kria-runtime:2022.1
RUN \
    apt install --yes graphviz ; \
    pip install pydot  ;\
    pip install meson ;\
    apt update --fix-missing ;\
    apt install --yes build-essential ninja-build ;

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV ROS_APT_SOURCE_VERSION=humble

# Copy sophus binaries to the runtime stage
COPY --from=build /usr/local/share/sophus /usr/local/share/sophus
COPY --from=build /usr/local/include/sophus /usr/local/include/sophus

RUN \
    apt update && apt install locales ;\
    locale-gen en_US en_US.UTF-8 ;\
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 ;\
    export LANG=en_US.UTF-8 ;

RUN apt install -y git

RUN mkdir -p /petalinux/ros_ws/src
RUN \
    cd /petalinux/ros_ws/src ;\
    git clone https://github.com/prophesee-ai/openeb.git --branch 5.0.0 ; 

# Setup to install ROS2 humble desktop version
RUN apt-get install -y curl
RUN apt-get install -y software-properties-common
RUN add-apt-repository -y universe
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null
RUN apt-get update
RUN apt-get install -y ros-humble-desktop python3-argcomplete ros-dev-tools libgmock-dev nlohmann-json3-dev libceres-dev libprotobuf-dev protobuf-compiler libglfw3-dev
# Install this in the runtime step, so that we can try to run metavision viewer
RUN \
    pip install meson ; \
    apt install --yes git clang libbpf-dev llvm udev libx11-dev libudev-dev libjpeg-dev libasound2-dev doxygen cmake libsdl2-dev qtbase5-dev libqt5opengl5-dev pkg-config build-essential ;\
    apt install ninja-build ;\
    cd /petalinux ;\
    git clone https://github.com/sanamshakya/v4l-utils.git;\
    cd v4l-utils;\
    meson setup build/ ; \
    ninja -C build/ ;\
    ninja -C build/ install ;
RUN apt install -y ros-humble-openeb-vendor
RUN apt update --fix-missing
#TODO: provide url to debian package, curl, then install
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/lib"
