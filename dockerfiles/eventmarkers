FROM xilinx/kria-runtime:2022.1
RUN \
    apt install --yes graphviz ; \
    pip install pydot  ;\
    pip install meson ;\
    apt update --fix-missing ;\
    apt install --yes build-essential ninja-build ;

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV ROS_APT_SOURCE_VERSION=humble


RUN \
    apt update && apt install locales ;\
    locale-gen en_US en_US.UTF-8 ;\
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 ;\
    export LANG=en_US.UTF-8 ;

RUN apt install -y git
#TODO: config files mount
RUN mkdir -p /petalinux/ros_ws/src

# Setup to install ROS2 humble desktop version
RUN apt-get install -y curl
RUN apt-get install -y software-properties-common
RUN add-apt-repository -y universe
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null
RUN apt-get update
RUN apt-get install -y ros-humble-desktop python3-argcomplete ros-dev-tools libgmock-dev nlohmann-json3-dev libceres-dev libprotobuf-dev protobuf-compiler libglfw3-dev

# MAVSDK
RUN curl -L https://github.com/mavlink/MAVSDK/releases/download/v3.17.2/libmavsdk-dev_3.17.2_debian11_arm64.deb -o  mavsdk-dev_3.17.2_debian11_arm64.deb && dpkg -i mavsdk-dev_3.17.2_debian11_arm64.deb  

# Install this in the runtime step, so that we can try to run metavision viewer
RUN \
    pip install meson ; \
    apt install --yes git clang libbpf-dev llvm udev libx11-dev libudev-dev libjpeg-dev libasound2-dev doxygen cmake libsdl2-dev qtbase5-dev libqt5opengl5-dev pkg-config build-essential ;\
    apt install ninja-build ;\
    cd /petalinux ;\
    git clone https://github.com/sanamshakya/v4l-utils.git;\
    cd v4l-utils;\
    meson setup build/ ; \
    ninja -C build/ ;\
    ninja -C build/ install ;
RUN apt install -y ros-humble-openeb-vendor
RUN apt install -y ros-humble-sophus
RUN apt update --fix-missing

#TODO: provide url to debian package, curl, then install
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/usr/local/lib"
